# Copy to .env and fill in. Never commit real secrets.

# Postgres connection string (lib/pq format or a postgres:// URL)
DATABASE_URL=postgres://naji@localhost:5432/workout_db?sslmode=disable

# Secret used to sign JWTs. Required — the server refuses to start without it.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

# Port to listen on (optional, defaults to 8080). Railway sets this automatically.
PORT=8080
